{
  "uid": "rubricmaker-application-usage",
  "title": "RubricMaker — Application Usage & Data Health",
  "description": "Product-level activity across every RubricMaker domain: counts, per-day counts and latest timestamps, read through the monitoring.app_* functions (migration 092), never the tables themselves. Requires SUPABASE_DB_HOST (and related vars) in .env.observability and a datasource role IN ROLE pg_monitor. No app instrumentation needed.",
  "tags": ["rubricmaker"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": { "from": "now-30d", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Teachers",
      "datasource": { "type": "postgres", "uid": "client_logs_postgres" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "client_logs_postgres" },
          "format": "table",
          "rawSql": "SELECT count FROM monitoring.app_entity_counts() WHERE domain = 'teachers'",
          "rawQuery": true
        }
      ]
    },
