      "id": 1,
      "type": "stat",
      "title": "Teachers",
      "datasource": { "type": "postgres", "uid": "client_logs_postgres" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
