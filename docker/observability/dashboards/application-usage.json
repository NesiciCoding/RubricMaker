    {
      "id": 21,
      "type": "table",
      "title": "Entity counts by domain",
      "datasource": { "type": "postgres", "uid": "client_logs_postgres" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 21 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "client_logs_postgres" },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT 'teachers' AS domain, count(*) AS count FROM profiles UNION ALL SELECT 'schools', count(*) FROM schools UNION ALL SELECT 'classes', count(*) FROM classes UNION ALL SELECT 'students', count(*) FROM students UNION ALL SELECT 'rubrics', count(*) FROM rubrics UNION ALL SELECT 'grades', count(*) FROM student_rubrics WHERE is_peer_review = false UNION ALL SELECT 'peer_reviews', count(*) FROM student_rubrics WHERE is_peer_review = true UNION ALL SELECT 'tests', count(*) FROM tests UNION ALL SELECT 'test_attempts', count(*) FROM student_tests UNION ALL SELECT 'essay_assignments', count(*) FROM essay_assignments UNION ALL SELECT 'essay_submissions', count(*) FROM essay_submissions UNION ALL SELECT 'messages', count(*) FROM messages UNION ALL SELECT 'flashcard_decks', count(*) FROM flashcard_decks UNION ALL SELECT 'flashcard_reviews', count(*) FROM flashcard_reviews UNION ALL SELECT 'question_bank_items', count(*) FROM question_bank_items UNION ALL SELECT 'marketplace_listings', count(*) FROM marketplace_listings UNION ALL SELECT 'grading_tasks', count(*) FROM grading_tasks ORDER BY 2 DESC"
        }
      ]
    },
    {
      "id": 22,
      "type": "table",
      "title": "Students & grades per school",
      "datasource": { "type": "postgres", "uid": "client_logs_postgres" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 21 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "client_logs_postgres" },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT s.name AS school, (SELECT count(*) FROM students st JOIN profiles p ON p.id = st.owner_id WHERE p.school_id = s.id) AS students, (SELECT count(*) FROM student_rubrics sr JOIN profiles p ON p.id = sr.grader_id WHERE p.school_id = s.id AND sr.is_peer_review = false) AS grades FROM schools s ORDER BY 2 DESC"
        }
      ]
    },
    {
      "id": 23,
      "type": "table",
      "title": "Most active teachers (grades)",
      "datasource": { "type": "postgres", "uid": "client_logs_postgres" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 29 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "client_logs_postgres" },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(NULLIF(p.display_name, ''), left(p.email, 1) || '•••') AS teacher, count(*) AS grades, max((sr.data->>'gradedAt')::timestamptz) AS last_graded FROM student_rubrics sr JOIN profiles p ON p.id = sr.grader_id WHERE sr.is_peer_review = false GROUP BY 1 ORDER BY 2 DESC LIMIT 20"
        }
      ]
    },
    {
      "id": 24,
      "type": "table",
      "title": "Latest activity per domain",
      "datasource": { "type": "postgres", "uid": "client_logs_postgres" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 29 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "client_logs_postgres" },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT 'profiles' AS domain, max(created_at) AS last_activity FROM profiles UNION ALL SELECT 'rubrics', max(updated_at) FROM rubrics UNION ALL SELECT 'grades', max((data->>'updatedAt')::timestamptz) FROM student_rubrics WHERE is_peer_review = false UNION ALL SELECT 'test_attempts', max((data->>'startedAt')::timestamptz) FROM student_tests UNION ALL SELECT 'essay_submissions', max(submitted_at) FROM essay_submissions UNION ALL SELECT 'messages', max(created_at) FROM messages UNION ALL SELECT 'flashcard_decks', max((data->>'updatedAt')::timestamptz) FROM flashcard_decks UNION ALL SELECT 'flashcard_reviews', max((data->>'updatedAt')::timestamptz) FROM flashcard_reviews UNION ALL SELECT 'marketplace', max(updated_at) FROM marketplace_listings ORDER BY 2 DESC NULLS LAST"
        }
      ]
    }
  ]
}
