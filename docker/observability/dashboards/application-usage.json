{
  "uid": "rubricmaker-application-usage",
  "title": "RubricMaker — Application Usage & Data Health",
  "description": "Product-level activity across every RubricMaker domain, queried directly from the Supabase database tables. Requires SUPABASE_DB_HOST (and related vars) in .env.observability so the 'Supabase Postgres (client_logs)' datasource is provisioned. No app instrumentation needed — works for any deployment with a reachable database.",
  "tags": ["rubricmaker"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": { "from": "now-30d", "to": "now" },
