    {
      "id": 19,
      "type": "timeseries",
      "title": "Daily activity — content created",
      "datasource": { "type": "postgres", "uid": "client_logs_postgres" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "client_logs_postgres" },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroup(created_at, '1d') AS time, count(*) AS rubrics FROM rubrics WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 1"
        },
        {
          "refId": "B",
          "datasource": { "type": "postgres", "uid": "client_logs_postgres" },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroup((COALESCE(data->>'gradedAt', data->>'updatedAt'))::timestamptz, '1d') AS time, count(*) AS grades FROM student_rubrics WHERE is_peer_review = false AND COALESCE(data->>'gradedAt', data->>'updatedAt') IS NOT NULL AND $__timeFilter((COALESCE(data->>'gradedAt', data->>'updatedAt'))::timestamptz) GROUP BY 1 ORDER BY 1"
        },
        {
          "refId": "C",
          "datasource": { "type": "postgres", "uid": "client_logs_postgres" },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroup(submitted_at, '1d') AS time, count(*) AS essays FROM essay_submissions WHERE $__timeFilter(submitted_at) GROUP BY 1 ORDER BY 1"
        },
        {
          "refId": "D",
          "datasource": { "type": "postgres", "uid": "client_logs_postgres" },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroup((data->>'startedAt')::timestamptz, '1d') AS time, count(*) AS test_attempts FROM student_tests WHERE $__timeFilter((data->>'startedAt')::timestamptz) GROUP BY 1 ORDER BY 1"
        }
      ]
    },
