{
  "uid": "rubricmaker-school-highlights",
  "title": "RubricMaker — School Highlights",
  "tags": [
    "rubricmaker",
    "wallboard"
  ],
  "description": "Aggregate, anonymous highlights for a school-wide screen: CEFR levels, grammar strengths and this week's activity. Teachers' totals come from school_highlight_snapshots (migration 108) through the monitoring.hl_* functions; figures with fewer than 5 students behind them are hidden. Open it with ?kiosk&var-school=<school name>.",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": {
    "from": "now-26w",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "school",
        "label": "School",
        "type": "query",
        "datasource": {
          "type": "postgres",
          "uid": "client_logs_postgres"
        },
        "query": "SELECT school FROM monitoring.hl_student_coverage() ORDER BY 1",
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Students represented",
      "datasource": {
        "type": "postgres",
        "uid": "client_logs_postgres"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "client_logs_postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT students AS \"students\" FROM monitoring.hl_student_coverage() WHERE school = ${school:sqlstring}"
        }
      ],
      "description": "Students whose teachers share their totals. Figures only appear once at least 5 students are behind them."
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Essays written this week",
      "datasource": {
        "type": "postgres",
        "uid": "client_logs_postgres"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 4,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "client_logs_postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT coalesce(max(this_week), 0) AS \"this week\", coalesce(max(last_week), 0) AS \"last week\" FROM monitoring.hl_week_activity() WHERE school = ${school:sqlstring} AND metric = 'essays'"
        }
      ]
    },
    {
      "id": 3,
