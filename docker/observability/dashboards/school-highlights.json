          "rawQuery": true,
          "rawSql": "SELECT label || ' (' || level || ')' AS topic, avg_score AS score FROM monitoring.hl_grammar_items() WHERE school = ${school:sqlstring} ORDER BY avg_score ASC, students DESC LIMIT 8"
        }
      ]
    },
    {
      "id": 11,
      "type": "bargauge",
      "title": "Most practised grammar topics",
      "datasource": {
        "type": "postgres",
        "uid": "client_logs_postgres"
      },
      "gridPos": {
        "h": 11,
        "w": 8,
        "x": 16,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "left"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "client_logs_postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT label || ' (' || level || ')' AS topic, students FROM monitoring.hl_grammar_items() WHERE school = ${school:sqlstring} ORDER BY students DESC, avg_score DESC LIMIT 8"
        }
      ],
      "description": "Students with evidence for the topic: test answers, flashcard progress or graded writing."
    },
    {
      "id": 12,
      "type": "barchart",
      "title": "Average grammar score by CEFR level",
      "datasource": {
        "type": "postgres",
        "uid": "client_logs_postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 35
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "orientation": "vertical",
        "legend": {
          "showLegend": false
        },
        "xTickLabelRotation": 0,
        "showValue": "auto",
        "stacking": "none",
        "tooltip": {
          "mode": "single"
        },
        "xField": "level"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "client_logs_postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT lv.level, (SELECT round(sum(g.avg_score * g.students) / nullif(sum(g.students), 0), 1) FROM monitoring.hl_grammar_items() g WHERE g.school = ${school:sqlstring} AND g.level = lv.level) AS \"average score\" FROM (VALUES ('A1'),('A2'),('B1'),('B2'),('C1'),('C2')) lv(level) ORDER BY 1"
        }
      ]
    }
  ]
