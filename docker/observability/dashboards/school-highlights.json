          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT coalesce(max(this_week), 0) AS \"this week\", coalesce(max(last_week), 0) AS \"last week\" FROM monitoring.hl_week_activity() WHERE school = ${school:sqlstring} AND metric = 'test_attempts'"
        }
      ]
    },
    {
      "id": 6,
      "type": "barchart",
      "title": "Students per CEFR level (overall)",
      "datasource": {
        "type": "postgres",
        "uid": "client_logs_postgres"
      },
      "gridPos": {
        "h": 10,
        "w": 8,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "orientation": "vertical",
        "legend": {
          "showLegend": false
        },
        "xTickLabelRotation": 0,
        "showValue": "auto",
        "stacking": "none",
        "tooltip": {
          "mode": "single"
        },
        "xField": "level"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "client_logs_postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT lv.level, (SELECT d.students FROM monitoring.hl_cefr_distribution('overall') d WHERE d.school = ${school:sqlstring} AND d.level = lv.level) AS students FROM (VALUES ('A1'),('A2'),('B1'),('B2'),('C1'),('C2')) lv(level) ORDER BY 1"
        }
      ],
      "description": "Levels with fewer than 5 students are not shown."
    },
    {
      "id": 7,
      "type": "barchart",
      "title": "CEFR level by skill",
      "datasource": {
        "type": "postgres",
        "uid": "client_logs_postgres"
      },
      "gridPos": {
        "h": 10,
        "w": 16,
        "x": 8,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "orientation": "vertical",
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "xTickLabelRotation": 0,
        "showValue": "auto",
        "stacking": "none",
        "tooltip": {
          "mode": "single"
        },
        "xField": "level"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "client_logs_postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT lv.level, (SELECT d.students FROM monitoring.hl_cefr_distribution('reading') d WHERE d.school = ${school:sqlstring} AND d.level = lv.level) AS reading, (SELECT d.students FROM monitoring.hl_cefr_distribution('writing') d WHERE d.school = ${school:sqlstring} AND d.level = lv.level) AS writing, (SELECT d.students FROM monitoring.hl_cefr_distribution('listening') d WHERE d.school = ${school:sqlstring} AND d.level = lv.level) AS listening, (SELECT d.students FROM monitoring.hl_cefr_distribution('speaking_production') d WHERE d.school = ${school:sqlstring} AND d.level = lv.level) AS speaking_production, (SELECT d.students FROM monitoring.hl_cefr_distribution('speaking_interaction') d WHERE d.school = ${school:sqlstring} AND d.level = lv.level) AS speaking_interaction FROM (VALUES ('A1'),('A2'),('B1'),('B2'),('C1'),('C2')) lv(level) ORDER BY 1"
        }
      ],
      "description": "Levels with fewer than 5 students are not shown."
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Share of students per CEFR level, by week",
      "datasource": {
        "type": "postgres",
        "uid": "client_logs_postgres"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "fillOpacity": 60,
            "drawStyle": "bars",
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "client_logs_postgres"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT week AS time, level AS metric, share FROM monitoring.hl_cefr_trend($__timeFrom(), $__timeTo()) WHERE school = ${school:sqlstring} ORDER BY 1"
        }
      ],
      "description": "Shares of the levels shown; levels with fewer than 5 students that week are left out of both the bars and the total."
    },
    {
      "id": 9,
      "type": "bargauge",
      "title": "Strongest grammar topics",
      "datasource": {
        "type": "postgres",
        "uid": "client_logs_postgres"
      },
      "gridPos": {
        "h": 11,
        "w": 8,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "max": 100,
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "left"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "client_logs_postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT label || ' (' || level || ')' AS topic, avg_score AS score FROM monitoring.hl_grammar_items() WHERE school = ${school:sqlstring} ORDER BY avg_score DESC, students DESC LIMIT 8"
        }
      ]
    },
