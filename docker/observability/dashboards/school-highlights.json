          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT coalesce(max(this_week), 0) AS \"this week\", coalesce(max(last_week), 0) AS \"last week\" FROM monitoring.hl_week_activity() WHERE school = ${school:sqlstring} AND metric = 'grades'"
        }
