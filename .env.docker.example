# RubricMaker — Docker environment configuration
# ─────────────────────────────────────────────────────────────────────────────
#
# ── OPTION A: Single machine or school LAN (HTTP) ────────────────────────────
#   1. ./scripts/generate-docker-secrets.sh   (creates .env with random secrets)
#   2. Set SITE_URL in .env to your machine's IP if other teachers need access
#   3. docker-compose up -d --build
#   4. Open SITE_URL in a browser
#
# ── OPTION B: VPS / public server (HTTPS + domain) ───────────────────────────
#   1. ./scripts/generate-docker-secrets.sh
#   2. Fill in DOMAIN and set SITE_URL to https://<your-domain>
#   3. docker-compose --profile https up -d --build
#   Caddy will automatically obtain a free Let's Encrypt certificate.
#   Firewall: open ports 80 and 443.


# ── URLs ──────────────────────────────────────────────────────────────────────

# Where teachers open RubricMaker. Examples:
#   http://localhost:8080          ← your own laptop
#   http://192.168.1.10:8080       ← school server on LAN
#   https://rubricmaker.school.nl  ← VPS with HTTPS (set DOMAIN below too)
SITE_URL=http://localhost:8080

# Domain for HTTPS (only needed with --profile https).
# Must match the A-record pointing to your VPS.
# Leave empty for HTTP-only deployments.
DOMAIN=


# ── Security ───────────────────────────────────────────────�
# docker-compose.yml refuses to start while any of these is empty.
# Run ./scripts/generate-docker-secrets.sh once: it creates .env from this file and fills in
# random values (it never changes a value that is already set). Keep .env private.

# Postgres admin password (also used by the auth, REST and storage database roles)
POSTGRES_PASSWORD=

# JWT signing secret (all login tokens are signed with this)
JWT_SECRET=

# ── API keys ───────────────────────────────────────────────�
# HS256 JWTs signed with JWT_SECRET (roles anon / service_role), plus the matching JWKS.
# The script above generates all three together; if you change JWT_SECRET by hand, regenerate them too
# (https://supabase.com/docs/guides/self-hosting/docker#generate-api-keys).
ANON_KEY=
SERVICE_ROLE_KEY=
JWT_JWKS=


# ── Email login (optional) ────────────────────────────────────────────────────
# Without SMTP: anonymous login works, but teachers can't link an email address
#               (rubric sharing across devices won't work).
# With SMTP: teachers can add their email and log in with an 8-digit OTP code.
#
# To enable:
#   1. Set MAILER_AUTOCONFIRM=false
#   2. Fill in your SMTP server details
#   3. Restart:  docker-compose up -d --force-recreate auth
#
# Common SMTP options:
#   Office 365:  smtp.office365.com  port 587
#   Gmail:       smtp.gmail.com      port 587  (needs an App Password)
#   Brevo:       smtp-relay.brevo.com port 587  (free tier: 300 emails/day)
# true lets anyone create an account with any email address and sign in at once. Use false on any server
# that is reachable beyond a trusted network, and configure SMTP below.
MAILER_AUTOCONFIRM=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER=rubricmaker@school.nl


# ── Stress-test logging (optional) ───────────────────────────────────────────
# When "true", the built app writes diagnostic events (user actions, sync
# results, errors — never free-text content) to the `client_logs` table for
# both the teacher and student portals. Leave unset for normal deployments;
# set to "true" only for the duration of a pilot/stress-test, then rebuild
# without it. Requires migration 035_client_logs.sql to be applied.
VITE_STRESS_TEST_LOGGING=
