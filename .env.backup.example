# RubricMaker — off-site backup configuration
# ─────────────────────────────────────────────────────────────────────────────
# Used by scripts/offsite-backup.sh, scripts/scheduled-backup.sh and scripts/restore-drill.sh.
#   cp .env.backup.example .env.backup && chmod 600 .env.backup
# Keep .env.backup private: it holds the bucket credentials and the encryption passphrase.
# Full guide: docs/SELF_HOSTING_OPS.md → Off-site backups.


# ── Bucket (any S3-compatible provider, NOT the provider that hosts this server) ──
# EU providers (data stays in the EU):
# Hetzner:        OFFSITE_S3_ENDPOINT=https://fsn1.your-objectstorage.com              OFFSITE_S3_REGION=fsn1
# Scaleway:       OFFSITE_S3_ENDPOINT=https://s3.fr-par.scw.cloud                      OFFSITE_S3_REGION=fr-par
# OVHcloud:       OFFSITE_S3_ENDPOINT=https://s3.gra.io.cloud.ovh.net                  OFFSITE_S3_REGION=gra
# IONOS:          OFFSITE_S3_ENDPOINT=https://s3.eu-central-3.ionoscloud.com           OFFSITE_S3_REGION=eu-central-3
# Others:
# Cloudflare R2:  OFFSITE_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com   OFFSITE_S3_REGION=auto
# Backblaze B2:   OFFSITE_S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com        OFFSITE_S3_REGION=eu-central-003
# Wasabi:         OFFSITE_S3_ENDPOINT=https://s3.eu-central-2.wasabisys.com            OFFSITE_S3_REGION=eu-central-2
OFFSITE_S3_ENDPOINT=
OFFSITE_S3_REGION=auto
OFFSITE_S3_BUCKET=
# Folder inside the bucket, so one bucket can hold several schools' backups.
OFFSITE_S3_PREFIX=rubricmaker
# An API key scoped to this one bucket (object read + write, plus delete unless OFFSITE_KEEP=0).
OFFSITE_S3_ACCESS_KEY_ID=
OFFSITE_S3_SECRET_ACCESS_KEY=
# rclone's S3 provider name; "Other" works for every provider above.
OFFSITE_S3_PROVIDER=Other


# ── Encryption ────────────────────────────────────────────────────────────────
# Backups are encrypted on this server before upload. Generate with: openssl rand -base64 32
# WITHOUT THIS PASSPHRASE NO OFF-SITE BACKUP CAN BE RESTORED. Store a copy outside this server
# (the school's password manager or a sealed envelope) — if the server is lost, so is this file.
BACKUP_ENCRYPTION_PASSPHRASE=


# ── Retention ─────────────────────────────────────────────────────────────────
# Off-site backups to keep (one per night when scheduled). 0 = never delete; let the bucket's
# lifecycle rules expire old copies instead (use that with a key that cannot delete).
OFFSITE_KEEP=30
# Local backups in ./backups to keep after a successful upload.
LOCAL_KEEP=7


# ── Monitoring (optional) ─────────────────────────────────────────────────────
# Pinged only when a run fully succeeds; point a dead-man's-switch monitor (Healthchecks.io,
# Better Stack, Uptime Kuma push) at each so a missed ping raises the alert.
BACKUP_HEARTBEAT_URL=
RESTORE_DRILL_HEARTBEAT_URL=
